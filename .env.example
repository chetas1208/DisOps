# Copy to .env and fill in values:  cp .env.example .env

# --- GMI Inference (GPT-5.5 vision, Kimi reasoning, inworld TTS) ---
GMI_API_KEY=
GMI_LLM_ENDPOINT_URL=https://api.gmi-serving.com
GMI_VISION_MODEL=openai/gpt-5.5
GMI_REQUEST_TIMEOUT_S=30
GMI_REASONING_MODEL=moonshotai/kimi-k2.7-code-highspeed
GMI_MAX_COMPLETION_TOKENS=256
GMI_TTS_MODEL=inworld-tts-2
GMI_TTS_VOICE_ID=Elizabeth
GMI_VIDEO_ENDPOINT_URL=https://console.gmicloud.ai

# --- GMI Compute (containers) — separate API key from inference ---
GMI_CLUSTER_API_KEY=
GMI_COMPUTE_IDC=us-denver-1
GMI_COMPUTE_PRODUCT=container.cpu.x1
GMI_TEMPLATE_ID=
DISOPS_IMAGE=ghcr.io/chetas1208/disops:latest

# --- App ---
HOST=0.0.0.0
PORT=8000
VOICE_PLAYBACK=1
VOICE_COOLDOWN_S=15
VOICE_STABLE_FRAMES=2

# --- Optional fallbacks (not used in GPT-5.5-only flow) ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
